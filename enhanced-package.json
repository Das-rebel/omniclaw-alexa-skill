{
  "name": "omniclaw-enhanced",
  "version": "1.0.0",
  "description": "OmniClaw Personal Assistant - Comprehensive digital life management system with Email Intelligence, Price Tracking, Media Streaming, and Story Narration",
  "main": "index.js",
  "scripts": {
    "start": "node infrastructure/cloud-functions/main.js",
    "dev": "nodemon infrastructure/cloud-functions/main.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit --coverage",
    "test:integration": "jest --testPathPattern=tests/integration --passWithNoTests",
    "test:e2e": "jest --testPathPattern=tests/e2e --detectOpenHandles",
    "test:performance": "jest tests/performance.test.js",
    "test:performance-suite": "./performance-test.sh",
    "test:load": "artillery run tests/load-test.yml",
    "test:story": "jest tests/story-narrator.test.js",
    "test:price": "jest tests/price-tracking.test.js",
    "test:media": "jest tests/media-streaming.test.js",
    "test:smoke:staging": "node tests/smoke/staging.js",
    "test:smoke:production": "node tests/smoke/production.js",
    "test:coverage": "jest --coverage --coverageReporters=json-summary --coverageReporters=text",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:performance",
    "test:watch": "jest --watch",
    "deploy": "npm run deploy:all",
    "deploy:health": "gcloud functions deploy omniclaw-health --gen2 --region=us-central1 --runtime=nodejs22 --memory=512MB --timeout=60s --trigger-http --allow-unauthenticated --entry-point=healthHandler --source=./deploy/functions/omniclaw-health --project=omniclaw-enhanced",
    "deploy:email": "gcloud functions deploy omniclaw-email --gen2 --region=us-central1 --runtime=nodejs22 --memory=512MB --timeout=60s --trigger-http --allow-unauthenticated --entry-point=emailHandler --source=./deploy/functions/omniclaw-email --set-secrets=GROQ_API_KEY=groq-api-key:latest,CEREBRAS_API_KEY=cerebras-api-key:latest,ZAI_API_KEY=zai-api-key:latest --project=omniclaw-enhanced",
    "deploy:price": "gcloud functions deploy omniclaw-price --gen2 --region=us-central1 --runtime=nodejs22 --memory=512MB --timeout=60s --trigger-http --allow-unauthenticated --entry-point=priceHandler --source=./deploy/functions/omniclaw-price --project=omniclaw-enhanced",
    "deploy:media": "gcloud functions deploy omniclaw-media --gen2 --region=us-central1 --runtime=nodejs22 --memory=512MB --timeout=60s --trigger-http --allow-unauthenticated --entry-point=mediaHandler --source=./deploy/functions/omniclaw-media --project=omniclaw-enhanced",
    "deploy:story": "gcloud functions deploy omniclaw-story --gen2 --region=us-central1 --runtime=nodejs22 --memory=512MB --timeout=60s --trigger-http --allow-unauthenticated --entry-point=storyHandler --source=./deploy/functions/omniclaw-story --project=omniclaw-enhanced",
    "deploy:analytics": "gcloud functions deploy omniclaw-analytics --gen2 --region=us-central1 --runtime=nodejs22 --memory=512MB --timeout=60s --trigger-http --allow-unauthenticated --entry-point=analyticsHandler --source=./deploy/functions/omniclaw-analytics --project=omniclaw-enhanced",
    "deploy:ml-analytics": "gcloud functions deploy omniclaw-ml-analytics --gen2 --region=us-central1 --runtime=nodejs22 --memory=2048MB --timeout=540s --trigger-http --allow-unauthenticated --entry-point=mlAnalyticsHandler --source=./deploy/functions/omniclaw-ml-analytics --set-secrets=GROQ_API_KEY=groq-api-key:latest,ZAI_API_KEY=zai-api-key:latest --project=omniclaw-enhanced",
    "deploy:model-server": "gcloud functions deploy omniclaw-model-server --gen2 --region=us-central1 --runtime=nodejs22 --memory=2048MB --timeout=540s --trigger-http --allow-unauthenticated --entry-point=modelServerHandler --source=./deploy/functions/omniclaw-model-server --project=omniclaw-enhanced",
    "deploy:all": "npm run deploy:health && npm run deploy:email && npm run deploy:price && npm run deploy:media && npm run deploy:story && npm run deploy:analytics && npm run deploy:ml-analytics && npm run deploy:model-server",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security": "npm audit --production",
    "security:fix": "npm audit fix",
    "backup": "node scripts/backup.js",
    "cleanup": "node scripts/cleanup.js",
    "install:all": "npm install && cd apps/email-intelligence && npm install && cd ../price-tracking && npm install && cd ../media-streaming && npm install && cd ../story-narrator && npm install && cd ../analytics && npm install",
    "clean": "rm -rf node_modules coverage dist */node_modules",
    "ml:train": "node ml-analytics/scripts/train-models.js",
    "ml:predict": "node ml-analytics/scripts/make-predictions.js",
    "ml:retrain": "node ml-analytics/scripts/retrain-models.js",
    "ml:evaluate": "node ml-analytics/scripts/evaluate-models.js",
    "ml:metrics": "node ml-analytics/scripts/show-metrics.js",
    "ml:drift-status": "node ml-analytics/scripts/check-drift.js",
    "ml:history": "node ml-analytics/scripts/training-history.js",
    "ml:test": "jest ml-analytics/tests --coverage"
  },
  "keywords": [
    "alexa",
    "personal-assistant",
    "email",
    "price-tracking",
    "media-streaming",
    "story-narrator",
    "multi-agent",
    "crewai"
  ],
  "author": "OmniClaw Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "@google-cloud/firestore": "^7.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/functions-framework": "^3.3.0",
    "@google-cloud/bigquery": "^7.0.0",
    "@google-cloud/storage": "^7.0.0",
    "@tensorflow/tfjs-node": "^4.17.0",
    "redis": "^4.6.10",
    "axios": "^1.6.5",
    "crewai": "^0.1.0",
    "openai": "^4.20.0",
    "elevenlabs": "^0.5.0",
    "playwright": "^1.40.0",
    "crawlee": "^3.5.0",
    "youtube-api": "^4.0.0",
    "spotify-web-api-node": "^5.0.2",
    "node-telegram-bot-api": "^0.64.0",
    "googleapis": "^128.0.0",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "node-cron": "^3.0.3",
    "bull": "^4.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.4",
    "artillery": "^2.0.3",
    "@types/jest": "^29.5.11",
    "nock": "^13.3.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
